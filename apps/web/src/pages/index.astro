---
import '@fontsource-variable/familjen-grotesk';
import '../styles/global.css';
import TryIt from '../components/TryIt.svelte';
import appIcon from '../../../../assets/brand/app-icon.svg';

const title = 'Glassboard';
const tagline = 'Draw on your screen. Then get back to work.';
const description = 'Glassboard is a small annotation tool for macOS and Windows. One shortcut turns your whole screen into a drawing surface. Press it again and the drawings are gone.';
const repo = 'https://github.com/ImNallen/Glassboard';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={`${title}: ${tagline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={Astro.site} />
    <title>{title}: {tagline}</title>
  </head>
  <body>
    <header class="wrap top">
      <a class="brand" href="/"><img src={appIcon.src} width="28" height="28" alt="" />Glassboard</a>
      <nav aria-label="Site">
        <a href={repo}>GitHub</a>
        <a href={`${repo}#run-locally`}>Build it from source</a>
      </nav>
    </header>

    <main class="wrap hero">
      <h1>Draw on your screen.<br />Then get back to work.</h1>
      <p class="lede">{description}</p>
      <div class="actions">
        <span class="try">
        <button class="button primary" type="button" data-glassboard-try>Try it on this page</button>
        <svg class="arrow" viewBox="0 0 220 120" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="stroke" x1="210" y1="10" x2="10" y2="86" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#f46b78" /><stop offset=".2" stop-color="#f2c85b" /><stop offset=".4" stop-color="#4dcaa0" /><stop offset=".6" stop-color="#4fc5d5" /><stop offset=".8" stop-color="#669df0" /><stop offset="1" stop-color="#a184e8" />
            </linearGradient>
          </defs>
          <path d="M210 10 C 190 70, 120 92, 12 86" stroke="url(#stroke)" stroke-width="5" stroke-linecap="round" />
          <path d="M46 66 L12 86 L48 104" stroke="url(#stroke)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        </span>
      </div>
    </main>

    <footer class="wrap">
      <ul class="facts">
        <li><strong>In and out with one shortcut.</strong> ⌘⇧A on a Mac, Ctrl Shift A on Windows. Returning to work clears every display, so the next session starts clean.</li>
        <li><strong>Every tool has a key.</strong> Arrows, pen, squares, circles, highlighter, text, and an eraser, in rainbow or solid colors, with optional auto-fade.</li>
        <li><strong>Runs only on your machine.</strong> No account, no server, no screen recording. Built with Rust, Tauri, and Svelte, and open source.</li>
      </ul>
      <div class="fine">
        <span>Installers aren't published yet. <a href={`${repo}#run-locally`}>Build it from source</a> with Node.js and Rust installed.</span>
        <span>The demo is the real Glassboard toolbar and drawing engine, running in your browser.</span>
      </div>
    </footer>

    <TryIt client:only="svelte" />
  </body>
</html>
