---
import '@fontsource-variable/familjen-grotesk';
import '../styles/global.css';
import TryIt from '../components/TryIt.svelte';
import Showcase from '../components/Showcase.svelte';
import GitHubIcon from '@glassboard/ui/GitHubIcon.svelte';
import appIcon from '../../../../assets/brand/app-icon.svg';
import { release } from '../lib/release.mjs';

const title = 'Glassboard';
const tagline = 'Draw on your screen. Then get back to work.';
const linuxAvailable = release.downloads.some(download => download.platform === 'linux');
const description = `Draw over any app, or capture and annotate a screenshot to share. Glassboard is a small, local annotation tool for ${linuxAvailable ? 'macOS, Windows, and experimental Linux X11 desktops' : 'macOS and Windows'}.`;
const repo = 'https://github.com/ImNallen/Glassboard';
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={`${title}: ${tagline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}: {tagline}</title>
  </head>
  <body>
    <header class="wrap top">
      <a class="brand" href={base}><img src={appIcon.src} width="28" height="28" alt="" />Glassboard</a>
      <nav aria-label="Site">
        <a href={repo}><GitHubIcon size={18} />GitHub</a>
      </nav>
    </header>

    <main class="wrap hero">
      <div class="row">
        <div class="intro">
          <p class="eyebrow">{linuxAvailable ? 'For macOS, Windows & Linux X11' : 'For macOS & Windows'}</p>
          <h1><span>Draw on your screen.</span> <span>Then get back to work.</span></h1>
          <p class="lede">Point things out over any app, or annotate a screenshot and copy it into a chat.</p>
          <div class="actions">
            {release.downloads.map(download => (
              <div class="download">
                <a class="button primary" href={download.url}>Download for {download.label}</a>
                <span>{download.architecture} · {download.format}</span>
              </div>
            ))}
          </div>
          <div class="release-links">
            <a href={release.notesUrl}>Version {release.version} · Release notes</a>
            <a href={`${base}install/`}>Installation help</a>
          </div>
          <div class="secondary-actions">
            <button class="source-link desktop-demo" type="button" data-glassboard-try>Try it on this page <span aria-hidden="true">→</span></button>
            <a class="source-link" href={`${repo}#build-from-source`}>Build from source <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="screen" aria-hidden="true">
          <div class="bar"><span></span><span></span><span></span></div>
          <div class="body">
            <div class="rail"><i></i><i></i><i></i><i></i></div>
            <i class="line title"></i>
            <i class="line l1"></i>
            <i class="line l2"></i>
            <div class="card"><i></i><i></i><i></i></div>
            <i class="line l3"></i>
            <i class="line l4"></i>
          </div>
          <Showcase client:only="svelte" />
        </div>
      </div>
    </main>

    <TryIt client:only="svelte" />
  </body>
</html>
